<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>gr.uoa.di.madgik.federation</groupId>
	<artifactId>search-aggregator</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>
	<name>Federation Search Aggregator</name>
	<description>Aggregates search results from multiple Resource Catalogue nodes into a single federation API endpoint.</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
		<module>search-aggregator-core</module>
		<module>search-aggregator-client</module>
		<module>search-aggregator-service</module>
	</modules>

	<properties>
		<revision>2.0.0-SNAPSHOT</revision>
		<java.version>25</java.version>
		<registry-core.version>5.0.0-SNAPSHOT</registry-core.version>
		<spring-boot.build-image.imageName>docker.madgik.di.uoa.gr/federation-search-aggregator:${project.version}</spring-boot.build-image.imageName>
		<dependency-check.version>13.0.0</dependency-check.version>
		<flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>gr.uoa.di.madgik.federation</groupId>
				<artifactId>search-aggregator-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>gr.uoa.di.madgik.federation</groupId>
				<artifactId>search-aggregator-client</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>gr.uoa.di.madgik</groupId>
				<artifactId>registry-core-api</artifactId>
				<version>${registry-core.version}</version>
			</dependency>
			<dependency>
				<groupId>gr.uoa.di.madgik</groupId>
				<artifactId>registry-core-rest</artifactId>
				<version>${registry-core.version}</version>
			</dependency>
			<dependency>
				<groupId>gr.uoa.di.madgik</groupId>
				<artifactId>eosc-node-registry-client</artifactId>
				<version>1.1.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<!-- Only search-aggregator-service builds a Spring Boot artifact/image -->
						<skip>true</skip>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-agent-integration</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>report-integration</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>report-integration</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>${dependency-check.version}</version>
				<configuration>
					<format>ALL</format>
					<prettyPrint>true</prettyPrint>
				</configuration>
			</plugin>
			<plugin>
				<!-- Resolves the ${revision} placeholder in installed/deployed POMs, so consumers see a real version -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>${flatten-maven-plugin.version}</version>
				<configuration>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>madgik-snapshots</id>
			<layout>default</layout>
			<url>https://repo.madgik.di.uoa.gr/content/repositories/snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>madgik-releases</id>
			<layout>default</layout>
			<url>https://repo.madgik.di.uoa.gr/content/repositories/releases</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>

	<distributionManagement>
		<repository>
			<id>madgik-releases</id>
			<url>https://repo.madgik.di.uoa.gr/content/repositories/releases</url>
		</repository>
		<snapshotRepository>
			<id>madgik-snapshots</id>
			<url>https://repo.madgik.di.uoa.gr/content/repositories/snapshots</url>
		</snapshotRepository>
	</distributionManagement>

</project>
